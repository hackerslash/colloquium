{
  "name": "colloquium",
  "private": true,
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "ytdlp": "node scripts/fetch-ytdlp.mjs",
    "predev": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-ytdlp.mjs",
    "prebuild": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-ytdlp.mjs",
    "sign:dev": "bash scripts/sign-dev.sh",
    "tauri:dev": "pnpm ffmpeg && pnpm ytdlp && cargo build --manifest-path src-tauri/Cargo.toml && bash scripts/sign-dev.sh && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:win": "pnpm ffmpeg && pnpm ytdlp && tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "peerjs": "^1.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
